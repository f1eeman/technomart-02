---
import Layout from '@/layouts/Layout.astro'
import Button from '@/components/button.astro'

const title = 'Страница не найдена — DEVICE'
const description =
  'Такой страницы в магазине DEVICE нет: отсюда можно уйти на главную, в каталог или в корзину.'
---

<Layout {title} {description} inner>
  <div class="lost-page">
    <h1 class="lost-title">Страница не найдена</h1>
    <p class="lost-text">
      Такой страницы у нас нет. Скорее всего, мы её убрали, а ссылку убрать
      забыли: со вторым у нас получается лучше. Ну или в адресе опечатка.
    </p>
    <p class="lost-text">
      Ничего при этом не пропало: корзина и сравнение лежат в браузере и от
      адреса не зависят.
    </p>
    <p class="lost-actions">
      <Button as="a" class="lost-button" href="/catalog">В каталог</Button>
    </p>
    <ul class="lost-links">
      <li>
        <a href="/">На главную</a> — плитки разделов, популярные товары и контакты
      </li>
      <li><a href="/cart">В корзину</a> — всё, что вы отложили раньше</li>
    </ul>
  </div>
</Layout>

<style>
  .lost-page {
    width: var(--layout-width);
    margin: 0 auto;
    margin-bottom: 90px;
    padding-right: 20px;
    padding-left: 80px;
  }

  .lost-title {
    margin: 0;
    margin-bottom: 33px;
    padding: 0;
    font-size: 47px;
    line-height: 48px;
  }

  .lost-text {
    width: 560px;
    margin: 0;
    margin-bottom: 30px;
    padding: 0;
    font-family: var(--font-open-sans);
    font-size: 15px;
    font-weight: normal;
    line-height: 30px;
  }

  .lost-actions {
    margin: 0;
    margin-top: 40px;
    margin-bottom: 40px;
    padding: 0;
  }

  .lost-button {
    padding-right: 23px;
    padding-left: 23px;
  }

  .lost-links {
    margin: 0;
    padding: 0;
    font-family: var(--font-open-sans);
    font-size: 15px;
    font-weight: normal;
    line-height: 30px;
    color: rgb(0 0 0 / 30%);
    list-style: none;
  }

  .lost-links a {
    color: var(--color-text);
    text-decoration: underline;
  }

  .lost-links a:hover,
  .lost-links a:focus {
    text-decoration: none;
  }
</style>
