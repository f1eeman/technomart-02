---
import Layout from '@/layouts/Layout.astro'
import Button from '@/components/button.astro'

const title = 'Магазин временно недоступен — DEVICE'
const description =
  'Магазин DEVICE сейчас не отвечает: товары не загрузились. Это ненадолго, попробуйте обновить страницу.'
---

<Layout {title} {description} inner>
  <div class="down-page">
    <h1 class="down-title">Магазин временно недоступен</h1>
    <p class="down-text">
      Товары сейчас не загрузились: у нас что-то отвалилось на стороне сервера.
      Это ненадолго — обновите страницу через минуту.
    </p>
    <p class="down-text">
      Корзина цела — она лежит у нас, а не в браузере, и вернётся вместе с
      магазином. Отложенное к сравнению не денется никуда: оно и правда в
      браузере.
    </p>
    <p class="down-actions">
      <Button as="a" class="down-button" href="/">Обновить главную</Button>
    </p>
  </div>
</Layout>

<style>
  .down-page {
    width: var(--layout-width);
    margin: 0 auto;
    margin-bottom: 90px;
    padding-right: 20px;
    padding-left: 80px;
  }

  .down-title {
    margin: 0;
    margin-bottom: 33px;
    padding: 0;
    font-size: 47px;
    line-height: 48px;
  }

  .down-text {
    width: 560px;
    margin: 0;
    margin-bottom: 30px;
    padding: 0;
    font-family: var(--font-open-sans);
    font-size: 15px;
    font-weight: normal;
    line-height: 30px;
  }

  .down-actions {
    margin: 0;
    margin-top: 40px;
    padding: 0;
  }

  .down-button {
    padding-right: 23px;
    padding-left: 23px;
  }
</style>
