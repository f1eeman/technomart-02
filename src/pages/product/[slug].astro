---
import Layout from '@/layouts/Layout.astro'
import PageHead from '@/components/page-head.astro'
import Button from '@/components/button.astro'
import {
  categoryBySlug,
  COLORS,
  PRODUCTS,
  priceLabel,
  titleOf,
  type Product,
} from '@/data/catalog'
import { CATALOG, HOME } from '@/data/nav'

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }))
}

interface Props {
  product: Product
}

const { product } = Astro.props

const category = categoryBySlug(product.category)

if (category === undefined) throw new Error(`Нет категории ${product.category}`)

const colorTitle =
  COLORS.find((color) => color.slug === product.color)?.title ?? product.color

const heading = titleOf(product)

const rows = [
  ...product.specs,
  { label: 'Цвет', value: colorTitle },
  { label: 'Bluetooth', value: product.bluetooth ? 'Есть' : 'Нет' },
  { label: 'Тип', value: product.kind },
]

const title = `${heading} — DEVICE`
const description = product.description
---

<Layout {title} {description} inner category={category.slug}>
  <PageHead
    {heading}
    crumbs={[
      HOME,
      CATALOG,
      { title: category.title, href: `/catalog/${category.slug}` },
      { title: heading },
    ]}
  />
  <div class="product-page">
    <div class="product-layout">
      <div class="product-gallery">
        <img
          src={product.image.src}
          width="360"
          height="380"
          alt={`Картинка — ${heading.toLowerCase()}`}
          data-fly-source
        />
      </div>
      <div class="product-info" data-notch>
        <p class="product-price">{priceLabel(product.price)}</p>
        <p class="product-actions">
          <Button class="to-cart" type="button" data-cart-add={product.slug}>
            В корзину
          </Button>
          <button
            class="add-compare"
            type="button"
            data-compare-add={product.slug}
          >
            Добавить к сравнению
          </button>
        </p>
        <p class="product-description">{product.description}</p>
        <h2 class="product-specs-title">Характеристики</h2>
        <dl class="product-specs">
          {
            rows.map((row) => (
              <div class="product-specs-row">
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</Layout>

<style>
  .product-page {
    width: var(--layout-width);
    margin: 0 auto;
    margin-bottom: 90px;
    padding-right: 20px;
    padding-left: 80px;
  }

  .product-layout {
    display: flex;
    column-gap: 70px;
  }

  .product-gallery {
    flex-shrink: 0;
    width: 360px;
  }

  .product-info {
    position: relative;
    width: 670px;
    padding-top: 30px;
  }

  .product-info::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 80px;
    height: 7px;
    background-color: var(--color-text);
  }

  .product-price {
    margin: 0;
    margin-bottom: 30px;
    padding: 0;
    font-family: var(--font-gilroy-light);
    font-size: 36px;
    font-weight: normal;
    line-height: 48px;
  }

  .product-actions {
    display: flex;
    align-items: center;
    column-gap: 30px;
    margin: 0;
    margin-bottom: 40px;
    padding: 0;
  }

  .to-cart {
    width: 200px;
    text-align: center;
  }

  .add-compare {
    border: none;
    font-family: var(--font-open-sans);
    font-size: 13px;
    font-weight: normal;
    line-height: 36px;
    color: rgb(0 0 0 / 50%);
    background-color: transparent;
    cursor: pointer;
  }

  .add-compare:hover,
  .add-compare:focus {
    color: var(--color-text);
    outline: none;
  }

  .add-compare:active {
    color: rgb(0 0 0 / 20%);
  }

  .product-description {
    margin: 0;
    margin-bottom: 50px;
    padding: 0;
    font-family: var(--font-open-sans);
    font-size: 15px;
    font-weight: normal;
    line-height: 30px;
    color: var(--color-surface-dark);
  }

  .product-specs-title {
    position: relative;
    margin: 0;
    margin-bottom: 30px;
    padding: 0;
    padding-top: 15px;
    font-size: 18px;
    font-weight: normal;
    line-height: 24px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .product-specs-title::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-text);
  }

  .product-specs {
    margin: 0;
    padding: 0;
  }

  .product-specs-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-block: 14px;
    border-bottom: 2px solid #e5e5e5;
  }

  .product-specs dt {
    font-family: var(--font-open-sans);
    font-size: 14px;
    font-weight: normal;
    line-height: 20px;
    color: rgb(0 0 0 / 50%);
  }

  .product-specs dd {
    margin: 0;
    font-size: 18px;
    line-height: 24px;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes refuse-compare {
      0%,
      100% {
        transform: translateX(0);
      }

      20% {
        transform: translateX(-5px);
      }

      50% {
        transform: translateX(5px);
      }

      80% {
        transform: translateX(-2px);
      }
    }

    .add-compare[data-full] {
      animation: refuse-compare 240ms ease-in-out;
    }
  }
</style>
