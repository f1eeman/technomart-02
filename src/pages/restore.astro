---
import Layout from '@/layouts/Layout.astro'
import PageHead from '@/components/page-head.astro'
import Button from '@/components/button.astro'
import Field from '@/components/field.astro'
import { HOME } from '@/data/nav'

const title = 'Восстановление пароля — DEVICE'
const description =
  'Восстановление пароля в интернет-магазине DEVICE: форма с e-mail и объяснение, почему пароль на сайте ничего не проверяет.'
---

<Layout {title} {description} inner>
  <PageHead
    heading="Восстановление пароля"
    crumbs={[
      HOME,
      { title: 'Вход', href: '/login' },
      { title: 'Восстановление пароля' },
    ]}
  />
  <div class="restore-page" data-restore>
    <p class="restore-lead">
      Здесь полагается ввести адрес, получить письмо и вернуть себе пароль.
      Письма не будет: почтового сервера у DEVICE нет. Зато есть форма — на неё
      бюджета хватило.
    </p>
    <form class="restore-form">
      <Field
        label="E-mail:"
        id="restore-email"
        field="email"
        name="email"
        type="email"
        autocomplete="email"
        placeholder="email@example.com"
      />
      <Button class="restore-submit" type="submit">Восстановить</Button>
      <p class="restore-error" data-restore-error hidden>Введите адрес.</p>
    </form>
    <p class="restore-done" data-restore-done hidden>
      Адрес принят. Письмо мы не отправили — нечем. Зато и ждать его сутки не
      пришлось.
    </p>
    <h2 class="restore-title">Почему пароль всё равно не проверяется</h2>
    <p class="restore-text">
      Вход в DEVICE — это имя, которым вы представились. Шапка начинает звать
      вас по имени, открывается личный кабинет, и на этом всё. Сверять пароль
      нам негде, хранить его — тем более.
    </p>
    <p class="restore-text">
      Поле пароля на странице входа оставлено для вида: оно ничего не проверяет
      и никуда не записывается. Забыть такой пароль невозможно — это
      единственная защита, которую мы смогли обеспечить.
    </p>
    <p class="restore-links">
      <a href="/login">Вернуться ко входу</a> ·
      <a href="/catalog">В каталог</a>
    </p>
  </div>
</Layout>

<script>
  import { initRestoreForm } from '@/scripts/forms'

  initRestoreForm()
</script>

<style>
  .restore-page {
    width: var(--layout-width);
    margin: 0 auto;
    margin-bottom: 90px;
    padding-right: 20px;
    padding-left: 80px;
  }

  .restore-lead {
    width: 560px;
    margin: 0;
    margin-bottom: 40px;
    padding: 0;
    font-family: var(--font-open-sans);
    font-size: 15px;
    font-weight: normal;
    line-height: 30px;
  }

  .restore-form {
    width: 390px;
    margin-bottom: 40px;
  }

  .restore-submit {
    width: 200px;
    text-align: center;
  }

  .restore-error,
  .restore-done {
    width: 560px;
    margin: 0;
    margin-top: 25px;
    padding: 0;
    font-family: var(--font-open-sans);
    font-size: 15px;
    font-weight: normal;
    line-height: 30px;
  }

  .restore-done {
    margin-bottom: 40px;
  }

  .restore-title {
    position: relative;
    margin: 0;
    margin-bottom: 25px;
    padding: 0;
    padding-top: 30px;
    font-size: 30px;
    font-weight: normal;
    line-height: 36px;
  }

  .restore-title::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 80px;
    height: 7px;
    background-color: var(--color-text);
  }

  .restore-text {
    width: 560px;
    margin: 0;
    margin-bottom: 30px;
    padding: 0;
    font-family: var(--font-open-sans);
    font-size: 15px;
    font-weight: normal;
    line-height: 30px;
  }

  .restore-links {
    margin: 0;
    margin-top: 40px;
    padding: 0;
    font-family: var(--font-open-sans);
    font-size: 15px;
    font-weight: normal;
    line-height: 30px;
    color: rgb(0 0 0 / 30%);
  }

  .restore-links a {
    color: var(--color-text);
    text-decoration: underline;
  }

  .restore-links a:hover,
  .restore-links a:focus {
    text-decoration: none;
  }
</style>
