---
import Layout from '@/layouts/Layout.astro'
import PageHead from '@/components/page-head.astro'
import CatalogFilter from '@/components/catalog-filter.astro'
import CatalogSort from '@/components/catalog-sort.astro'
import Pagination from '@/components/pagination.astro'
import ProductCard from '@/components/product-card.astro'
import { categoryBySlug } from '@/data/catalog'
import { CATALOG, HOME } from '@/data/nav'
import { ApiError, type ProductsQuery } from '@/scripts/api'
import type { CatalogBounds, CatalogState } from '@/scripts/catalog-url'
import { apiFor } from '@/server/api'

const category = categoryBySlug(Astro.params.category ?? '')

if (category === undefined) return Astro.rewrite('/404')

const asked = Astro.url.searchParams

const oneOf = <T extends string>(
  raw: string | null,
  allowed: readonly T[],
): T | undefined => allowed.find((item) => item === raw)

const numberOf = (raw: string | null): number | undefined => {
  if (raw === null) return undefined

  const parsed = Number.parseInt(raw, 10)

  return Number.isFinite(parsed) ? parsed : undefined
}

const bt = oneOf(asked.get('bt'), ['yes', 'no', 'any'] as const)
const sort = oneOf(asked.get('sort'), ['price', 'kind', 'popularity'] as const)
const dir = oneOf(asked.get('dir'), ['asc', 'desc'] as const)
const min = numberOf(asked.get('min'))
const max = numberOf(asked.get('max'))
const page_ = numberOf(asked.get('page'))
const colors = asked.get('colors')

const query: ProductsQuery = {
  category: category.slug,
  ...(min === undefined ? {} : { min }),
  ...(max === undefined ? {} : { max }),
  ...(colors === null ? {} : { colors }),
  ...(bt === undefined ? {} : { bt }),
  ...(sort === undefined ? {} : { sort }),
  ...(dir === undefined ? {} : { dir }),
  ...(page_ === undefined ? {} : { page: page_ }),
}

const api = apiFor(Astro.request)

const [range, categories, page] = await Promise.all([
  api.priceRange(category.slug),
  api.categories(),
  api.products(query).catch((error: unknown) => {
    if (error instanceof ApiError && error.status === 400)
      return api.products({ category: category.slug })

    throw error
  }),
])

const bounds: CatalogBounds = { lowest: range.min, highest: range.max }

const state: CatalogState = {
  min: min ?? bounds.lowest,
  max: max ?? bounds.highest,
  colors: colors === null ? [] : colors.split(',').filter(Boolean),
  bt: bt ?? 'any',
  sort: sort ?? 'price',
  dir: dir ?? 'asc',
  page: page_ ?? 1,
}

const inCategory =
  categories.items.find((item) => item.slug === category.slug)?.total ?? 0
const maxPages = Math.max(Math.ceil(inCategory / page.pageSize), 1)
const sample =
  page.items[0] ??
  (await api
    .products({ category: category.slug })
    .then((all) => all.items[0] ?? null)
    .catch(() => null))

const title = `${category.title} — DEVICE`
const description = `${category.title} в интернет-магазине DEVICE: ${String(page.total)} позиций, фильтр по цене, цвету и Bluetooth.`
---

<Layout {title} {description} inner category={category.slug}>
  <PageHead
    heading={category.title}
    crumbs={[HOME, CATALOG, { title: category.title }]}
  />
  <div class="catalog-columns">
    <CatalogFilter lowest={range.min} highest={range.max} {state} />
    <div class="sort-catalog-wrapper">
      <CatalogSort {state} {bounds} />
      <section class="products-catalog">
        <h2 class="visually-hidden">Список: {category.title}</h2>
        <ul class="products-catalog-list" data-catalog={category.slug}>
          {page.items.map((product) => <ProductCard {product} />)}
        </ul>
        <div class="catalog-ghosts" data-catalog-ghosts aria-hidden="true">
        </div>
        <p class="catalog-empty" data-catalog-empty hidden={page.total > 0}>
          Под такой фильтр ничего не подошло. Попробуйте ослабить условия.
        </p>
        <Pagination
          pages={maxPages}
          active={page.totalPages}
          current={page.page}
          empty={page.total === 0}
          {state}
          {bounds}
        />
        {
          sample !== null && (
            <template data-product-template>
              <ProductCard product={sample} />
            </template>
          )
        }
      </section>
    </div>
  </div>
</Layout>

<script>
  import { initCatalog } from '@/scripts/catalog'

  initCatalog()
</script>

<style>
  .catalog-columns {
    position: relative;
    display: flex;
    flex-wrap: nowrap;
    width: var(--layout-width);
    margin: 0 auto;
    padding-right: 20px;
    padding-left: 80px;
  }

  .sort-catalog-wrapper {
    width: 830px;
    padding-left: 70px;
    background-color: var(--color-bg);
  }

  .products-catalog {
    position: relative;
  }

  .catalog-ghosts {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }

  .products-catalog-list {
    display: flex;
    flex-wrap: wrap;
    column-gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .catalog-empty {
    margin: 0;
    margin-bottom: 40px;
    padding: 0;
    font-family: var(--font-open-sans);
    font-size: 15px;
    font-weight: normal;
    line-height: 30px;
    color: var(--color-surface-dark);
  }
</style>
