---
import type { Crumb } from '@/data/nav'

interface Props {
  crumbs: Crumb[]
}

const { crumbs } = Astro.props
---

<ul class="breadcrumbs">
  {
    crumbs.map((crumb) => (
      <li class:list={[crumb.href === undefined && 'breadcrumbs-current']}>
        {crumb.href === undefined ? (
          crumb.title
        ) : (
          <a href={crumb.href}>{crumb.title}</a>
        )}
      </li>
    ))
  }
</ul>

<style>
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    margin-bottom: 50px;
    padding: 0;
    font-family: var(--font-open-sans);
    font-size: 14px;
    font-weight: normal;
    line-height: 24px;
    color: rgb(0 0 0 / 30%);
    list-style: none;
  }

  .breadcrumbs li {
    position: relative;
    margin-right: 17px;
    padding-right: 17px;
  }

  .breadcrumbs li:last-child {
    margin-right: 0;
    padding-right: 0;
  }

  .breadcrumbs li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -2px;
    width: 6px;
    height: 6px;
    margin-top: -2px;
    border: 2px solid #0b0b0b;
    border-bottom: none;
    border-left: none;
    transform: rotate(45deg);
  }

  .breadcrumbs a {
    color: rgb(0 0 0 / 30%);
  }

  .breadcrumbs a:hover,
  .breadcrumbs a:focus {
    color: rgb(0 0 0 / 60%);
  }

  .breadcrumbs a:active {
    color: rgb(0 0 0 / 10%);
  }
</style>
