---
import type { HTMLTag, Polymorphic } from 'astro/types'

type Props<Tag extends HTMLTag = 'button'> = Polymorphic<{ as: Tag }>

const { as: Tag = 'button', class: className, ...attrs } = Astro.props
---

<Tag class:list={['button', className]} {...attrs}>
  <span class="button-content"><slot /></span>
</Tag>

<style>
  .button {
    position: relative;
    display: inline-block;
    padding-block: 8px;
    border: none;
    font-family: inherit;
    font-size: 18px;
    font-weight: normal;
    line-height: 20px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    vertical-align: baseline;
    color: var(--color-text);
    background-color: transparent;
    cursor: pointer;
  }

  .button::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 10;
    width: 100%;
    height: 8px;
    margin-top: -4px;
    background-color: var(--color-accent);
    transition-duration: 200ms;
  }

  .button:hover::before,
  .button:focus::before {
    top: 0;
    height: 100%;
    margin-top: 0;
  }

  .button:active {
    color: rgb(0 0 0 / 30%);
  }

  .button-content {
    position: relative;
    z-index: 100;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes bar-run {
      0% {
        clip-path: inset(0 100% 0 0);
      }

      50% {
        clip-path: inset(0 0 0 0);
      }

      100% {
        clip-path: inset(0 0 0 100%);
      }
    }

    .button[data-ran]::before {
      animation: bar-run 440ms cubic-bezier(0.4, 0, 0.2, 1);
    }
  }
</style>
