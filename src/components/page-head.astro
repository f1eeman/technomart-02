---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import type { Crumb } from '@/data/nav'

interface Props {
  heading: string
  crumbs: Crumb[]
}

const { heading, crumbs } = Astro.props
---

<div class="page-wrapper">
  <h1 class="page-title">{heading}</h1>
  <Breadcrumbs {crumbs} />
</div>

<style>
  .page-wrapper {
    width: var(--layout-width);
    margin: 0 auto;
    padding-right: 20px;
    padding-left: 80px;
  }

  .page-title {
    margin: 0;
    margin-bottom: 33px;
    padding: 0;
    font-size: 47px;
    line-height: 48px;
  }
</style>
