---
import Button from '@/components/button.astro'
import { priceLabel, searchTextOf, titleOf, type Product } from '@/data/catalog'

interface Props {
  product: Product
  searchable?: boolean
}

const { product, searchable = false } = Astro.props
---

<li
  class="product-item"
  data-product={product.slug}
  data-price={String(product.price)}
  data-color={product.color}
  data-bluetooth={product.bluetooth ? 'yes' : 'no'}
  data-kind={product.kind}
  data-popularity={String(product.popularity)}
  data-search={searchable ? searchTextOf(product) : undefined}
>
  <div class="product-item-image">
    <div class="image-box">
      <img
        src={product.image.src}
        width="360"
        height="380"
        alt={`Картинка — ${titleOf(product).toLowerCase()}`}
        data-fly-source
      />
    </div>
    <p class="hover-box">
      <Button class="in-cart" type="button" data-cart-add={product.slug}>
        В корзину
      </Button>
      <button class="add-compare" type="button" data-compare-add={product.slug}>
        Добавить к сравнению
      </button>
    </p>
  </div>
  <div class="product-item-box">
    <a class="product-item-title-link" href={`/product/${product.slug}`}>
      <h3 class="product-item-title">
        {
          product.titleLines.map((line, at) => (
            <>
              {at > 0 && <br />}
              {line}
            </>
          ))
        }
      </h3>
    </a>
    <span class="product-item-price">{priceLabel(product.price)}</span>
  </div>
</li>

<style>
  .product-item {
    display: flex;
    flex-wrap: wrap;
    width: 360px;
    min-height: 460px;
    margin-bottom: 40px;
  }

  .product-item-image {
    position: relative;
  }

  .hover-box {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    display: flex;
    flex-flow: column wrap;
    align-items: center;
    width: 360px;
    height: 380px;
    margin: 0;
    padding: 0;
    opacity: 0;
    background-color: rgb(238 238 238 / 80%);
  }

  .in-cart {
    width: 200px;
    margin-top: 170px;
    margin-bottom: 5px;
    font-size: 18px;
    line-height: 24px;
    text-align: center;
  }

  .add-compare {
    border: none;
    font-family: var(--font-open-sans);
    font-size: 13px;
    font-weight: normal;
    line-height: 36px;
    color: rgb(0 0 0 / 50%);
    background-color: transparent;
    cursor: pointer;
  }

  .add-compare:hover,
  .add-compare:focus {
    color: var(--color-text);
    outline: none;
  }

  .add-compare:active {
    color: rgb(0 0 0 / 20%);
  }

  .image-box {
    position: relative;
    z-index: 10;
    width: 360px;
    height: 380px;
  }

  .image-box:hover + .hover-box,
  .image-box:focus + .hover-box,
  .hover-box:hover,
  .hover-box:focus-within {
    z-index: 100;
    opacity: 1;
  }

  .product-item-box {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    width: 100%;
    height: 48px;
    margin: 0;
    margin-top: auto;
    padding: 0;
  }

  .product-item-title-link {
    width: 260px;
    font-family: var(--font-gilroy-extrabold);
    font-size: 18px;
    font-weight: normal;
    line-height: 24px;
    color: var(--color-text);
  }

  .product-item-title-link:hover,
  .product-item-title-link:focus {
    color: rgb(0 0 0 / 60%);
  }

  .product-item-title-link:active {
    color: rgb(0 0 0 / 30%);
  }

  .product-item-title {
    margin: 0;
    padding: 0;
    font-size: 18px;
    line-height: 24px;
  }

  .product-item-price {
    margin-left: auto;
    font-family: var(--font-gilroy-light);
    font-size: 16px;
    font-weight: normal;
    line-height: 24px;
    color: var(--color-surface-dark);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes refuse-card {
      0%,
      100% {
        transform: translateX(0);
      }

      20% {
        transform: translateX(-5px);
      }

      50% {
        transform: translateX(5px);
      }

      80% {
        transform: translateX(-2px);
      }
    }

    .hover-box {
      transition: opacity 200ms;
    }

    .add-compare[data-full] {
      animation: refuse-card 240ms ease-in-out;
    }
  }
</style>
